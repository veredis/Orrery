{
  "name": "orrery",
  "productName": "Orrery",
  "version": "0.1.1",
  "description": "Orrery — an AI-first Matrix client for Hermes and other agents",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "author": "Orrery contributors",
  "homepage": "./",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/gen-icons.mjs && vite build",
    "build:web": "node scripts/gen-icons.mjs && vite build --mode web",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "models": "node scripts/fetch-whisper.mjs",
    "electron": "electron .",
    "licenses": "node scripts/third-party-licenses.mjs",
    "dist:win": "npm run licenses && npm run build && electron-builder --win --x64",
    "harness": "node scripts/harness/hermes-e2e.mjs",
    "version": "npm run licenses && git add THIRD-PARTY-LICENSES.txt",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "electron-updater": "6.8.11"
  },
  "bundledInApp": [
    "@huggingface/transformers",
    "dompurify",
    "highlight.js",
    "marked",
    "matrix-encrypt-attachment",
    "matrix-js-sdk",
    "react",
    "react-dom",
    "zustand"
  ],
  "devDependencies": {
    "@huggingface/transformers": "4.3.2",
    "@resvg/resvg-js": "2.6.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.3.0",
    "dompurify": "3.4.17",
    "electron": "45.3.2",
    "electron-builder": "26.18.0",
    "fake-indexeddb": "6.2.8",
    "highlight.js": "11.12.0",
    "jsdom": "^26.1.0",
    "marked": "18.2.0",
    "matrix-encrypt-attachment": "^1.0.3",
    "matrix-js-sdk": "45.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "^5.9.3",
    "vite": "8.3.8",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.1.0",
    "zustand": "5.1.0"
  },
  "build": {
    "appId": "dev.orrery.app",
    "productName": "Orrery",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "!dist/**/*.map",
      "electron/**/*",
      "package.json",
      "LICENSE",
      "NOTICE.md"
    ],
    "extraResources": [
      {
        "from": "THIRD-PARTY-LICENSES.txt",
        "to": "THIRD-PARTY-LICENSES.txt"
      }
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Orrery",
      "artifactName": "Orrery-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "veredis",
        "repo": "Orrery",
        "releaseType": "draft"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/veredis/Orrery.git"
  }
}
